NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only GitHub App configuration. Never expose these as NEXT_PUBLIC_* values.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_STATE_SECRET=
# Optional. Defaults to NEXT_PUBLIC_SITE_URL + /api/integrations/github/callback
GITHUB_APP_CALLBACK_URL=

# Server-only Notion public OAuth configuration. Never expose these as NEXT_PUBLIC_* values.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# HMAC key for signed, time-bounded OAuth state and Notion binding integrity proofs.
# Use at least 32 bytes of independent random secret material.
NOTION_OAUTH_STATE_SECRET=
# Base64-encoded 32-byte AES-256-GCM key. Keep independent from the OAuth state secret.
NOTION_CREDENTIAL_ENCRYPTION_KEY=
# Optional. Defaults to NEXT_PUBLIC_SITE_URL + /api/integrations/notion/callback
NOTION_REDIRECT_URI=
